{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question-version-evidence.schema.json",
  "title": "Question version dependency evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "active_iteration", "questions"],
  "properties": {
    "schema_version": {"const": "2"},
    "active_iteration": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "source_iteration", "dependency_manifest", "status"],
        "properties": {
          "question_id": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
          "source_iteration": {"type": "string", "pattern": "^v[0-9]{3,}$"},
          "dependency_manifest": {"$ref": "#/$defs/artifactBinding"},
          "status": {"const": "current"}
        }
      }
    }
  },
  "$defs": {
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)(?:\\.\\.?)(?:/|$))(?!.*//)(?!.*[\\\\\\u0000-\\u001F\\u007F\\u2028\\u2029])(?=.*\\S)(?!.*(?:^|/)$).+$"
    }
  }
}
