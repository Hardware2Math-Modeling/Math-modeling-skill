{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate-confirmation.schema.json",
  "title": "Explicit user gate confirmation provenance v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "actor_type",
    "confirmation_method",
    "confirmed_by",
    "confirmed_at",
    "artifact_hashes"
  ],
  "properties": {
    "schema_version": {"const": "2"},
    "actor_type": {"const": "user"},
    "confirmation_method": {"const": "explicit"},
    "confirmed_by": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "confirmed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "artifact_hashes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
