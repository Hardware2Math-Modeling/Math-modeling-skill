{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper-request.schema.json",
  "title": "Trusted paper request v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "requested", "deliverables", "request_event"],
  "properties": {
    "schema_version": {"const": "2"},
    "requested": {"type": "boolean"},
    "deliverables": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["paper-writing", "paper-production"]}
    },
    "request_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "provenance_type", "provider", "event_id", "event_type", "actor_id", "occurred_at", "challenge_sha256"],
      "properties": {
        "schema_version": {"const": "2"},
        "provenance_type": {"const": "trusted_user_event"},
        "provider": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "event_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "event_type": {"const": "paper-request"},
        "actor_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "occurred_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
        "challenge_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"requested": {"const": true}}, "required": ["requested"]},
      "then": {"properties": {"deliverables": {"minItems": 1}}},
      "else": {"properties": {"deliverables": {"maxItems": 0}}}
    }
  ]
}
