{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "initialization.schema.json",
  "title": "Math modeling project initialization v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "competition",
    "python_executable",
    "template_path",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "2"},
    "competition": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "python_executable": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])",
      "not": {"pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"}
    },
    "template_path": {
      "type": ["string", "null"],
      "pattern": "^(?=[\\s\\S]*\\S)(?!/)(?![A-Za-z]:)(?![\\s\\S]*[\\u0000-\\u001F\\u007F\\u2028\\u2029])(?![\\s\\S]*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?![\\s\\S]*//)(?![\\s\\S]*/$)[^\\\\]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    }
  }
}
