{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "accepted-model-interface.schema.json",
  "title": "Accepted model interface v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "model_id", "specification", "inputs", "outputs"],
  "properties": {
    "schema_version": {"const": "2"},
    "status": {"const": "accepted"},
    "model_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "specification": {
      "$ref": "#/$defs/artifactBinding"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    }
  },
  "$defs": {
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)(?:\\.\\.?)(?:/|$))(?!.*//)(?!.*[\\\\\\u0000-\\u001F\\u007F\\u2028\\u2029])(?=.*\\S)(?!.*(?:^|/)$).+$"
    }
  }
}
