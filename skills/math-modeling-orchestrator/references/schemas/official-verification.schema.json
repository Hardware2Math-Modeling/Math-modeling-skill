{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "official-verification.schema.json",
  "title": "CUMCM official source verification v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "competition",
    "source_type",
    "source_url",
    "verified_at",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2"},
    "competition": {"const": "CUMCM"},
    "source_type": {"enum": ["rule", "template"]},
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^\\s/]+(?:/[^\\s]*)?$"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
