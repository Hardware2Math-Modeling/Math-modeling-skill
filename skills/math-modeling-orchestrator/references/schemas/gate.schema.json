{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate.schema.json",
  "title": "Math modeling confirmation gate v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gate_id", "status", "artifact_hashes", "notes", "rollback_stage"],
  "properties": {
    "schema_version": {"const": "2"},
    "gate_id": {"enum": ["gate1", "gate2", "gate3"]},
    "status": {"enum": ["pending", "confirmed", "rejected"]},
    "confirmed_by": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "confirmed_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "confirmation": {"$ref": "gate-confirmation.schema.json"},
    "artifact_hashes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "uniqueItems": true
    },
    "notes": {"type": "string"},
    "rollback_stage": {
      "type": ["string", "null"],
      "enum": [null, "preflight", "problem-analysis", "data-analysis", "model-construction", "model-solving", "visualization", "validation", "paper-writing", "paper-production"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "confirmed"}}
      },
      "then": {
        "required": ["confirmed_by", "confirmed_at", "confirmation"],
        "properties": {
          "confirmed_by": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "confirmed_at": {"type": "string", "minLength": 1, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
          "confirmation": {"$ref": "gate-confirmation.schema.json"},
          "artifact_hashes": {"minItems": 1}
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["confirmed_by"]},
            {"required": ["confirmed_at"]},
            {"required": ["confirmation"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "rejected"}}
      },
      "then": {
        "properties": {"rollback_stage": {"type": "string", "enum": ["preflight", "problem-analysis", "data-analysis", "model-construction", "model-solving", "visualization", "validation", "paper-writing", "paper-production"]}}
      }
    }
  ]
}
