{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handoff.schema.json",
  "title": "Math modeling handoff v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "state",
    "context",
    "artifacts",
    "quality",
    "result",
    "next"
  ],
  "properties": {
    "schema_version": {"const": "2"},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "objectives", "constraints"],
      "properties": {
        "statement": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "objectives": {"$ref": "#/$defs/nonEmptyStrings"},
        "constraints": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_stage", "status", "validation_status", "completed_stages", "invalidated_stages"],
      "properties": {
        "current_stage": {"$ref": "#/$defs/stage"},
        "status": {"enum": ["pending", "in_progress", "complete", "needs_revision", "skipped"]},
        "validation_status": {"enum": ["pending", "pass", "needs_revision", "stale"]},
        "completed_stages": {"type": "array", "items": {"$ref": "#/$defs/stage"}, "uniqueItems": true},
        "invalidated_stages": {"type": "array", "items": {"$ref": "#/$defs/stage"}, "uniqueItems": true}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumptions", "variables", "data", "methods", "decisions", "equations", "parameters"],
      "properties": {
        "assumptions": {"$ref": "#/$defs/evidenceObjects"},
        "variables": {"$ref": "#/$defs/evidenceObjects"},
        "data": {"$ref": "#/$defs/evidenceObjects"},
        "methods": {"$ref": "#/$defs/evidenceObjects"},
        "decisions": {"$ref": "#/$defs/evidenceObjects"},
        "equations": {"$ref": "#/$defs/evidenceObjects"},
        "parameters": {"$ref": "#/$defs/evidenceObjects"}
      }
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks", "warnings", "confidence", "limitations"],
      "properties": {
        "checks": {"$ref": "#/$defs/evidenceObjects"},
        "warnings": {"$ref": "#/$defs/nonEmptyStrings"},
        "confidence": {"enum": ["high", "medium", "low"]},
        "limitations": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "details", "accepted_model", "rejected_alternatives", "evidence", "computed_values", "citations"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "details": {"$ref": "#/$defs/nonEmptyStrings"},
        "accepted_model": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"},
        "rejected_alternatives": {"$ref": "#/$defs/evidenceObjects"},
        "evidence": {"$ref": "#/$defs/nonEmptyStrings"},
        "computed_values": {"$ref": "#/$defs/evidenceObjects"},
        "citations": {"$ref": "#/$defs/evidenceObjects"}
      }
    },
    "next": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended_stage", "rationale", "alternatives", "failed_checks"],
      "properties": {
        "recommended_stage": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/recommendedStage"}]},
        "rationale": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "alternatives": {"$ref": "#/$defs/nonEmptyStrings"},
        "failed_checks": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {"properties": {"status": {"const": "needs_revision"}}}
        }
      },
      "then": {
        "properties": {
          "next": {"properties": {"failed_checks": {"minItems": 1}}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {"properties": {"status": {"const": "needs_revision"}, "current_stage": {"const": "preflight"}}}
        }
      },
      "then": {"properties": {"next": {"properties": {"recommended_stage": {"enum": [null, "preflight"]}}}}}
    },
    {
      "if": {
        "properties": {
          "state": {"properties": {"status": {"const": "needs_revision"}, "current_stage": {"const": "problem-analysis"}}}
        }
      },
      "then": {"properties": {"next": {"properties": {"recommended_stage": {"enum": [null, "preflight", "problem-analysis"]}}}}}
    },
    {
      "if": {
        "properties": {
          "state": {"properties": {"status": {"const": "needs_revision"}, "current_stage": {"const": "data-analysis"}}}
        }
      },
      "then": {"properties": {"next": {"properties": {"recommended_stage": {"enum": [null, "preflight", "problem-analysis", "data-analysis"]}}}}}
    },
    {
      "if": {
        "properties": {
          "state": {"properties": {"status": {"const": "needs_revision"}, "current_stage": {"const": "model-construction"}}}
        }
      },
      "then": {"properties": {"next": {"properties": {"recommended_stage": {"enum": [null, "preflight", "problem-analysis", "data-analysis", "model-construction"]}}}}}
    },
    {
      "if": {
        "properties": {
          "state": {"properties": {"status": {"const": "needs_revision"}, "current_stage": {"const": "model-solving"}}}
        }
      },
      "then": {"properties": {"next": {"properties": {"recommended_stage": {"enum": [null, "preflight", "problem-analysis", "data-analysis", "model-construction", "model-solving"]}}}}}
    },
    {
      "if": {
        "properties": {
          "state": {"properties": {"status": {"const": "needs_revision"}, "current_stage": {"const": "visualization"}}}
        }
      },
      "then": {"properties": {"next": {"properties": {"recommended_stage": {"enum": [null, "preflight", "problem-analysis", "data-analysis", "model-construction", "model-solving", "visualization"]}}}}}
    },
    {
      "if": {
        "properties": {
          "state": {"properties": {"status": {"const": "needs_revision"}, "current_stage": {"const": "validation"}}}
        }
      },
      "then": {"properties": {"next": {"properties": {"recommended_stage": {"enum": [null, "preflight", "problem-analysis", "data-analysis", "model-construction", "model-solving", "visualization", "validation"]}}}}}
    },
    {
      "if": {
        "properties": {
          "state": {"properties": {"status": {"const": "needs_revision"}, "current_stage": {"const": "paper-writing"}}}
        }
      },
      "then": {"properties": {"next": {"properties": {"recommended_stage": {"enum": [null, "preflight", "problem-analysis", "data-analysis", "model-construction", "model-solving", "visualization", "validation", "paper-writing"]}}}}}
    },
    {
      "if": {
        "properties": {
          "state": {"properties": {"status": {"const": "needs_revision"}, "current_stage": {"const": "paper-production"}}}
        }
      },
      "then": {"properties": {"next": {"properties": {"recommended_stage": {"enum": [null, "preflight", "problem-analysis", "data-analysis", "model-construction", "model-solving", "visualization", "validation", "paper-writing", "paper-production"]}}}}}
    }
  ],
  "$defs": {
    "stage": {
      "enum": ["preflight", "problem-analysis", "data-analysis", "model-construction", "model-solving", "visualization", "validation", "paper-writing", "paper-production"]
    },
    "recommendedStage": {
      "enum": ["preflight", "problem-analysis", "data-analysis", "model-construction", "model-solving", "visualization", "validation", "paper-writing", "paper-production", "complete"]
    },
    "nonEmptyStrings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    },
    "evidenceObjects": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {"$ref": "#/$defs/evidenceValue"}
      }
    },
    "evidenceValue": {
      "oneOf": [
        {"type": "string", "minLength": 1, "pattern": "\\S"},
        {"type": ["number", "boolean", "null"]},
        {"type": "array", "items": {"$ref": "#/$defs/evidenceValue"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/evidenceValue"}}
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "description"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "kind": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "description": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=[\\s\\S]*\\S)(?!/)(?![A-Za-z]:)(?![\\s\\S]*[\\u0000-\\u001F\\u007F\\u2028\\u2029])(?![\\s\\S]*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?![\\s\\S]*//)(?![\\s\\S]*/$)[^\\\\]+$"
    }
  }
}
